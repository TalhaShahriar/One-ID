# --- DATABASE CONFIG ---
# Connection string pointing to your PostgreSQL database (e.g. Neon free tier)
DATABASE_URL="postgresql://user:password@ep-cool-planet-1234.ap-southeast-1.aws.neon.tech/votechain_bd?sslmode=require"

# --- SECURITY CONFIG ---
# Secret key for signing JWT tokens (should be a secure random 32+ character string)
JWT_SECRET="super-secret-random-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Secret key for HMAC ledger signing
LEDGER_HMAC_SECRET="super-secret-ledger-hmac-key"

# --- SERVER RUNTIME ---
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- EMAIL SERVICE CONFIG (Nodemailer / SMTP) ---
# Your Gmail address used for sending high-security OTP codes
EMAIL_USER="noreply.votechain.bd@gmail.com"
# Your 16-character Google App Password (not your standard email password)
EMAIL_PASS="your-app-specific-password-here"

# --- INTEGRATIONS & CLOUD RUN ---
# Automatically populated in Google AI Studio environment
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
APP_URL="YOUR_APP_URL_OR_DEPLOYED_URL_HERE"
